# GhostInit env — placeholders for .env.example
BETTER_AUTH_SECRET=REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARS
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
APP_NAME=pharmeazor
# Postgres (used when --database postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharmeazor
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_POOL_SIZE=20
# Optional Convex if you switch to --database convex
# CONVEX_URL=REPLACE_WITH_CONVEX_URL_https://example-123.convex.cloud
# Set true only when the origin is private and your proxy overwrites X-Forwarded-For
# Required for non-local BETTER_AUTH_URL values so rate limiting never shares one fallback bucket
TRUSTED_PROXY=false

# Maintenance mode — MAINTENANCE_MODE=true serves /maintenance to visitors
MAINTENANCE_MODE=false
# Optional bypass: submit this token through the /maintenance form; never place it in a URL
# MAINTENANCE_BYPASS_TOKEN=

# OAuth — optional, set to enable social login (google, github)
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET

RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=pharmeazor

# Billing: Stripe (global, USD), Chargily (Algeria, DZD) and manual transfer (Algeria, DZD) — selected providers only
# Configure manual payment recipient instructions before enabling submissions (see docs/manual-payments.md).
# The plans are basic, standard and pro. Each plan needs a provider price id per rail.
# Stripe global cards
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
BILLING_STRIPE_BASIC_PRICE_ID=REPLACE_WITH_STRIPE_BASIC_PRICE_ID
BILLING_STRIPE_STANDARD_PRICE_ID=REPLACE_WITH_STRIPE_STANDARD_PRICE_ID
BILLING_STRIPE_PRO_PRICE_ID=REPLACE_WITH_STRIPE_PRO_PRICE_ID
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE

# Chargily Algeria EDAHABIA/CIB
CHARGILY_API_KEY=REPLACE_WITH_CHARGILY_API_KEY
CHARGILY_SECRET_KEY=REPLACE_WITH_CHARGILY_SECRET_KEY
BILLING_CHARGILY_BASIC_PRICE_ID=REPLACE_WITH_CHARGILY_BASIC_PRICE_ID
BILLING_CHARGILY_STANDARD_PRICE_ID=REPLACE_WITH_CHARGILY_STANDARD_PRICE_ID
BILLING_CHARGILY_PRO_PRICE_ID=REPLACE_WITH_CHARGILY_PRO_PRICE_ID
CHARGILY_MODE=test

# Analytics — PostHog product analytics + feature flags + experiments + session replay
# Cloud US: https://us.i.posthog.com, EU: https://eu.i.posthog.com, or /ingest proxy to bypass adblockers (default)
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_POSTHOG_KEY
EXPO_PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST=/ingest
EXPO_PUBLIC_POSTHOG_HOST=/ingest
POSTHOG_HOST=https://us.i.posthog.com
# Set POSTHOG_API_KEY to enable server analytics, even when it matches the public project key
POSTHOG_API_KEY=phc_REPLACE_WITH_POSTHOG_KEY
FEATURE_FLAG_TIMEOUT_MS=2500
NEXT_PUBLIC_POSTHOG_SESSION_RECORDING=false
EXPO_PUBLIC_POSTHOG_SESSION_RECORDING=false
NEXT_PUBLIC_POSTHOG_AUTOCAPTURE=true
EXPO_PUBLIC_POSTHOG_AUTOCAPTURE=true
NEXT_PUBLIC_ANALYTICS_DISABLED=false
EXPO_PUBLIC_ANALYTICS_DISABLED=false
ANALYTICS_DISABLED=false

# Shared production API rate limiting and optional cache — Upstash Redis
UPSTASH_REDIS_REST_URL=REPLACE_WITH_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REDIS_REST_TOKEN

# Attachment storage — local by default; switch STORAGE_DRIVER=s3 explicitly
STORAGE_DRIVER=local
UPLOADS_DIR=./data/uploads
STORAGE_BUCKET=REPLACE_WITH_STORAGE_BUCKET
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_ACCESS_KEY
S3_ENDPOINT=
S3_PUBLIC_URL=

# Notifications — self-issued device-token protection key

# Durable jobs — bounded worker and scheduler timings

# Eve durable agent — string model IDs use Vercel AI Gateway
AI_GATEWAY_API_KEY=REPLACE_WITH_AI_GATEWAY_API_KEY
# Eve durable agent — direct Groq provider (openai/gpt-oss-120b)
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
EVE_INTERNAL_AUTH_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Leave origin empty for the integrated withEve process; set it for a separate Eve service
EVE_NEXT_PRODUCTION_ORIGIN=
EVE_NEXT_PRODUCTION_PORT=4274

# oRPC contract-first, single port 3000
# No separate API_PORT

# Runtime bun only
RUNTIME=bun
