{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "#*": ["./agent/*"],
      "#evals/*": ["./evals/*"],
      "@repo/*": ["../../packages/*/src"]
    },
    "rootDir": "."
  },
  "include": ["agent/**/*", "lib/**/*"],
  "exclude": ["node_modules", "dist", ".eve"]
}
