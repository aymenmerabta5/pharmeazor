{
  "name": "@tooling/cleaning-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Offline pipeline that turns the raw PHARMEAZOR collection into a clean corpus.",
  "scripts": {
    "clean": "python run.py",
    "clean:no-chunks": "python run.py --no-chunks",
    "clean:one": "python run.py --only-med",
    "r2:dry-run": "python ../bucket_operations.py --dry-run --group cleaning push",
    "r2:upload": "python ../bucket_operations.py push --group cleaning",
    "r2:verify": "python ../bucket_operations.py verify --source output --prefix cleaning-lab",
    "r2:download": "python ../bucket_operations.py pull --group cleaning",
    "r2:status": "python ../bucket_operations.py status --group cleaning",
    "r2:organize": "python ../bucket_operations.py organize --group cleaning",
    "r2:reset": "python ../bucket_operations.py reset --group cleaning",
    "r2:sync": "python ../bucket_operations.py sync --group cleaning",
    "check:python": "python -m compileall -q settings.py pipeline run.py ../bucket_operations.py ../storage-lab",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  }
}
