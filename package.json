{
  "name": "pharmeazor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/architecture",
    "tooling/cleaning-lab",
    "tooling/retrieval-lab"
  ],
  "type": "module",
  "scripts": {
    "audit:dependencies": "bun scripts/audit-dependencies.ts",
    "audit:lock": "bun scripts/audit-dependencies.ts --lock-only",
    "audit:lock:refresh": "bun scripts/audit-dependencies.ts --refresh-lock-evidence",
    "build": "bun scripts/build-with-eve.mjs",
    "check": "bunx --bun ghostinit@0.1.0 check",
    "check:fix": "bunx --bun ghostinit@0.1.0 check --fix",
    "bucket:organize": "python tooling/bucket_operations.py organize",
    "bucket:pull": "python tooling/bucket_operations.py pull",
    "bucket:push": "python tooling/bucket_operations.py push",
    "bucket:reset": "python tooling/bucket_operations.py reset",
    "bucket:run": "python tooling/run_pipeline.py",
    "bucket:status": "python tooling/bucket_operations.py status",
    "bucket:sync": "python tooling/bucket_operations.py sync",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:ensure-extensions": "bun --conditions=react-server --env-file=.env.local packages/api/src/workers/database/ensure-extensions.ts --ghostinit-database-extension-bootstrap",
    "db:migrate:billing": "bun --env-file=.env.local packages/database/src/workers/database/migrate-billing-subscriptions.ts --ghostinit-billing-migration",
    "db:verify": "bun --env-file=.env.local packages/database/src/workers/database/verify.ts",
    "retrieval:ensure-schema": "bun --conditions=react-server --env-file=.env.local packages/database/src/workers/database/ensure-retrieval.ts --retrieval-schema",
    "retrieval:backfill-provenance": "bun --conditions=react-server --env-file=.env.local packages/api/src/workers/retrieval/backfill-provenance.ts",
    "retrieval:import-aliases": "bun --conditions=react-server --env-file=.env.local packages/api/src/workers/retrieval/import-aliases.ts",
    "retrieval:contextualize": "bun --conditions=react-server --env-file=.env.local packages/api/src/workers/retrieval/contextualize.ts",
    "retrieval:ingest": "bun --conditions=react-server --env-file=.env.local packages/api/src/workers/retrieval/ingest.ts",
    "retrieval:ingest:dry": "bun --conditions=react-server --env-file=.env.local packages/api/src/workers/retrieval/ingest.ts --dry-run",
    "retrieval:ingest:vectors": "bun --conditions=react-server --env-file=.env.local packages/api/src/workers/retrieval/ingest.ts --vectors tooling/embedding-lab/output/embeddings",
    "retrieval:ingest:vectors:dry": "bun --conditions=react-server --env-file=.env.local packages/api/src/workers/retrieval/ingest.ts --vectors tooling/embedding-lab/output/embeddings --dry-run",
    "dev": "bun --env-file=.env.local run turbo run dev",
    "doctor:fix": "bunx --bun ghostinit@0.1.0 doctor --fix",
    "eve:build": "bun --env-file=.env.local run --cwd apps/harness build",
    "eve:dev": "bun --env-file=.env.local run --cwd apps/harness dev:diagnostic",
    "eve:start": "bun --env-file=.env.local run --cwd apps/harness start:diagnostic",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "install:bootstrap": "bun scripts/security-dependencies.cjs install --bootstrap",
    "install:cmd": "bun run install:verified",
    "install:verified": "bun scripts/security-dependencies.cjs install",
    "lint": "bun scripts/lib/dependency-security-integrity.cjs && oxlint --deny-warnings . && bun scripts/check-import-aliases.cjs && bun scripts/check-next-parity.cjs && bun scripts/check-navigation-imports.cjs",
    "lint:all": "bun run lint && bun run lint:architecture && bun run lint:rtl && bun run lint:animations && bun run lint:server-only && bun run typecheck",
    "lint:animations": "bun scripts/check-animation-imports.cjs",
    "lint:architecture": "bun scripts/check-feature-folder.cjs && bun scripts/check-frontend-ownership.cjs",
    "lint:imports": "bun scripts/check-import-aliases.cjs",
    "lint:navigation": "bun scripts/check-navigation-imports.cjs",
    "lint:next-parity": "bun scripts/check-next-parity.cjs",
    "lint:oxlint": "bun scripts/lib/dependency-security-integrity.cjs && oxlint --deny-warnings .",
    "lint:rtl": "bun scripts/check-rtl-logical.cjs",
    "lint:server-only": "bun scripts/check-server-only.cjs",
    "lint:tooling-integrity": "bun scripts/lib/dependency-security-integrity.cjs",
    "lock:resolve": "bun install --lockfile-only --ignore-scripts",
    "prepare": "husky",
    "security:audit": "bun scripts/security-dependencies.cjs audit",
    "security:fix": "bun scripts/security-dependencies.cjs fix",
    "start": "bun --env-file=.env.local run start:production",
    "start:eve": "node apps/harness/.output/server/index.mjs",
    "start:production": "bun scripts/start-production.mjs",
    "start:web": "bun run --cwd apps/web start",
    "storage:cleanup-worker": "bun --conditions=react-server packages/api/src/workers/storage/cleanup.ts --ghostinit-storage-cleanup-worker",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "bun-types": "1.4.5",
    "husky": "9.1.7",
    "oxc-parser": "0.159.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@expo/cli/zod": "4.6.6",
    "@vercel/oidc": "4.0.6",
    "decode-uri-component": "0.5.1",
    "drizzle-orm": "0.45.4",
    "node-forge": "1.4.3",
    "pdfkit": "0.20.2",
    "undici": "8.12.3"
  },
  "engines": {
    "bun": "1.4.5"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "image-size@1.2.1": "patches/image-size@1.2.1.patch",
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
