{
  "name": "@tooling/retrieval-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Offline collection lab that discovers, downloads and validates the PHARMEAZOR medicine corpus.",
  "scripts": {
    "collect": "python main.py collect-all",
    "verify": "python main.py verify",
    "report": "python main.py report",
    "r2:dry-run": "python ../bucket_operations.py --dry-run --group retrieval push",
    "r2:upload": "python ../bucket_operations.py push --group retrieval",
    "r2:verify": "python ../bucket_operations.py verify --source data/raw --prefix retrieval-lab/raw",
    "r2:download": "python ../bucket_operations.py pull --group retrieval",
    "r2:status": "python ../bucket_operations.py status --group retrieval",
    "r2:organize": "python ../bucket_operations.py organize --group retrieval",
    "r2:reset": "python ../bucket_operations.py reset --group retrieval",
    "r2:sync": "python ../bucket_operations.py sync --group retrieval",
    "check:python": "python -m compileall -q main.py config.py ../bucket_operations.py ../storage_lab src",
    "eval": "python eval/evaluate_rag_baseline.py && oxfmt --write eval/results",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  }
}
